# Public browser configuration. Use the publishable/anon key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STALE_AFTER_SECONDS=15
VITE_OFFLINE_AFTER_SECONDS=90
VITE_ACTIVE_WINDOW_HOURS=24

# Private backend configuration. Never prefix with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# ESP32 firmware configuration, private and never exposed to the browser.
ESP_LOCAL_ID=001
ESP_DEVICE_CODE=SGE-004
ESP_DEVICE_TOKEN=
ESP_WIFI_SSID=
ESP_WIFI_PASSWORD=
# Importing this file into Vercel configures the frontend build only.
# Also publish NVIDIA_* to Supabase secrets for weekly-analysis.

# Private Edge Function environment only (do not prefix with VITE_).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase hosting.
# MAX_FUTURE_SECONDS=60
# MAX_AGE_DAYS=7
# MAX_BODY_BYTES=16384
# DEVICE_MESSAGES_PER_MINUTE=120
# BODY_READ_TIMEOUT_MS=5000
# STORE_TIMEOUT_MS=5000
# Automatic retention/expunge is not enabled.
# Technical communication rules are configured by admin RPC, not browser secrets.
# No communication rule or scheduler is enabled by this environment file.
