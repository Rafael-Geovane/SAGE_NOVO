{
  "name": "sage-wearable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:bundle": "node scripts/build-sql.mjs",
    "esp:prepare": "node scripts/prepare-esp32.mjs",
    "check:client": "node scripts/check-client-secrets.mjs",
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests scripts supabase docs *.json *.md *.html *.ts",
    "format:check": "prettier --check src tests scripts supabase docs *.json *.md *.html *.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "three": "0.187.0",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.6"
  }
}
